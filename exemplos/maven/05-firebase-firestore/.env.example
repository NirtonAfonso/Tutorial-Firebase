# Configuracao do Firebase para Projeto Maven (Firebase Admin SDK)
# 1. Copie este arquivo para ".env" na mesma pasta do pom.xml.
# 2. Preencha o ID do projeto e o caminho completo do arquivo JSON da conta de servico.
# 3. Guarde o arquivo JSON FORA da pasta do repositorio Git!
# 4. NUNCA envie o arquivo ".env" nem o arquivo ".json" para o GitHub!

FIREBASE_PROJECT_ID=seu-id-do-projeto
FIREBASE_CREDENTIALS=C:\credenciais\urna-firebase-chave.json
