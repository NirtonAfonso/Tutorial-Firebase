# Configuracao do Firebase para Projeto Java Comum (API REST)
# 1. Copie este arquivo para ".env" nesta mesma pasta.
# 2. Preencha com os dados do seu projeto no Firebase Console.
# 3. NUNCA envie o arquivo ".env" para o GitHub!

FIREBASE_PROJECT_ID=seu-id-do-projeto
FIREBASE_API_KEY=sua-chave-api-web
FIREBASE_EMAIL=urna.teste@exemplo.com
FIREBASE_PASSWORD=sua-senha-de-teste
