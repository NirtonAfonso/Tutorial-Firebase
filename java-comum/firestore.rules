rules_version = '2';
service cloud.firestore {
  match /databases/{banco}/documents {
    function eContaDoLaboratorio() {
      return request.auth != null && request.auth.uid == 'COLE_AQUI_O_UID';
    }

    function votoDeTreinoValido(id) {
      let dados = request.resource.data;
      return id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && dados.keys().hasAll(['tipo', 'numero'])
        && dados.keys().hasOnly(['tipo', 'numero'])
        && dados.numero is string
        && (
          (dados.tipo == 'BRANCO' && dados.numero == '')
          || (dados.numero.matches('^[0-9]{2}$') && (
            (dados.tipo == 'NOMINAL'
              && exists(/databases/$(banco)/documents/candidatos_demo/$(dados.numero)))
            || (dados.tipo == 'NULO'
              && !exists(/databases/$(banco)/documents/candidatos_demo/$(dados.numero)))
          ))
        );
    }

    match /candidatos_demo/{numero} {
      allow get, list: if eContaDoLaboratorio();
    }

    match /votos_demo/{id} {
      allow create: if eContaDoLaboratorio() && votoDeTreinoValido(id);
      // Permite repetir a mesma gravação após uma falha de rede.
      allow update: if eContaDoLaboratorio() && request.resource.data == resource.data;
    }
  }
}
